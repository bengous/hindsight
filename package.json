{
  "name": "hindsight",
  "private": true,
  "bin": {
    "hindsight": "./src/cli/main.ts"
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.bun.json && tsc -p tsconfig.mod.json",
    "lint": "oxlint -c oxlint.config.ts --format=unix .",
    "lint:fix": "oxlint -c oxlint.config.ts --fix --quiet .; bun run format",
    "format": "oxfmt --write -c oxfmt.config.ts 'src/**/*.{ts,tsx}' 'fixtures/**/*.ts' 'tools/**/*.ts' 'docs/plan/*.ts' 'docs/plan/tsconfig.json' 'types/index.d.ts' '*.config.ts' package.json 'tsconfig*.json' bunfig.toml",
    "format:check": "oxfmt --check -c oxfmt.config.ts 'src/**/*.{ts,tsx}' 'fixtures/**/*.ts' 'tools/**/*.ts' 'docs/plan/*.ts' 'docs/plan/tsconfig.json' 'types/index.d.ts' '*.config.ts' package.json 'tsconfig*.json' bunfig.toml"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.4",
    "effect": "4.0.4"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@oxlint/plugins": "1.87.0",
    "@types/bun": "1.4.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.87.0",
    "oxlint-plugin-complexity": "3.0.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  }
}
