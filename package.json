{
  "name": "hindsight",
  "private": true,
  "type": "module",
  "bin": {
    "hindsight": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.mod.json",
    "lint": "oxlint --format=unix src --ignore-pattern types",
    "format": "oxfmt --write -c .oxfmtrc.jsonc src",
    "format:check": "oxfmt --check -c .oxfmtrc.jsonc src"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.4",
    "effect": "4.0.4"
  }
}
