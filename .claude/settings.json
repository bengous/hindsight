{
  "claudeMdExcludes": ["**/.repos/**"],
  "permissions": {
    "deny": ["Read(/.repos/effect/LLMS.md)", "Read(/.repos/effect/.agents/**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/vendor-effect.sh",
            "async": true
          }
        ]
      }
    ]
  }
}
